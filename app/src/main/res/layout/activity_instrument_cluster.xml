<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 左侧 - 转速表 -->
    <LinearLayout
        android:id="@+id/rpm_panel"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="转速"
            android:textColor="#888888"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_rpm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="rpm"
            android:textColor="#888888"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/pb_rpm"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            android:max="80"
            android:progress="0"
            android:progressDrawable="@drawable/progress_rpm" />

        <!-- 电量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="32dp">

            <ImageView
                android:id="@+id/iv_battery_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_battery" />

            <ProgressBar
                android:id="@+id/pb_battery"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:max="100"
                android:progress="65"
                android:progressDrawable="@drawable/progress_battery" />

            <TextView
                android:id="@+id/tv_battery_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="65%"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- 水温 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_temperature" />

            <ProgressBar
                android:id="@+id/pb_temperature"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:max="130"
                android:progress="88"
                android:progressDrawable="@drawable/progress_temperature" />

            <TextView
                android:id="@+id/tv_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="88°C"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 中间 - 速度表（主显示区） -->
    <LinearLayout
        android:id="@+id/speed_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <!-- 档位显示 -->
        <TextView
            android:id="@+id/tv_gear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P"
            android:textColor="#00E5FF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:background="@drawable/bg_gear"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp" />

        <!-- 速度数值 -->
        <TextView
            android:id="@+id/tv_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#00FF88"
            android:textSize="140sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tv_speed_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="km/h"
            android:textColor="#888888"
            android:textSize="24sp" />

        <ProgressBar
            android:id="@+id/pb_speed"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="12dp"
            android:layout_marginTop="16dp"
            android:max="240"
            android:progress="0"
            android:progressDrawable="@drawable/progress_speed" />
    </LinearLayout>

    <!-- 右侧 - 里程信息 -->
    <LinearLayout
        android:id="@+id/odometer_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:gravity="end"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_odometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="总里程: 12580.5 km"
            android:textColor="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_trip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="小计: 256.3 km"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 底部 - 导航信息 -->
    <LinearLayout
        android:id="@+id/nav_container"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:background="#1A1A2E"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_turn_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_turn_straight" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tv_turn_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="沿当前道路直行"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_nav_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="剩余 500米"
                android:textColor="#00E5FF"
                android:textSize="16sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_nav_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="预计 15分钟"
            android:textColor="#888888"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 警告信息 -->
    <LinearLayout
        android:id="@+id/warning_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="#CCFF0000"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_warning"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_warning" />

        <TextView
            android:id="@+id/tv_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="警告信息"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />
    </LinearLayout>

</RelativeLayout>
